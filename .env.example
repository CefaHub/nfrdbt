# Public Telegram Desktop TEST credentials, NOT reliable for production.
TELEGRAM_API_ID=17349
TELEGRAM_API_HASH=344583e45741c457fe1862106095a5eb
# The BOT_TOKEN is provided in the Bothost bot creation form.
BOT_TOKEN=
# Generate locally using gen_session.py, NEVER include in ZIP or GitHub!
SESSION_STRING=
# One-time activation key is supplied separately to owner; it is NOT in GitHub.
# No PAIR_CODE environment variable is required for the new activation mechanism.
# Persist state across deployments on Bothost.
DATA_DIR=/app/data
# Gift catalog poll frequency, NOT the NFT collection sweep.
CHECK_INTERVAL=60
# Legacy name: interpreted as the target duration of a FULL NFT sweep.
NFT_SCAN_INTERVAL=60
# Explicit target, overriding NFT_SCAN_INTERVAL. Minimum 60 seconds.
NFT_SWEEP_SECONDS=60
# Throttle between base collection queries to reduce Telegram FloodWait.
NFT_REQUEST_SPACING_SECONDS=0.40
# Interval in seconds for manually watched gifts (minimum 60)
DEAL_WATCH_INTERVAL=180
TRACK_RARE_NFTS=true
# Send alerts for every newly issued, non-crafted collectible NFT.
# Command /all on/off can override this for the authorized owner.
NOTIFY_ALL_NFTS=true
# NFT Radar 2.0: guest see.tg WebSocket is free and needs NO token.
LIVE_ENABLED=true
# Optional auth for available public profile IDs in the WSS feed. Never commit this.
SEE_TG_API_TOKEN=
# Only WebSocket is used; paid see.tg REST methods are intentionally disabled.
LIVE_NOTIFY_NEW=true
LIVE_NOTIFY_BARGAINS=true
# Notify only at or below 75% of observed sale median, with >=3 matches.
LIVE_BARGAIN_RATIO=0.75
# Avoid Telegram message flood: global WSS upgrades capped per minute.
LIVE_MAX_NEW_PER_MINUTE=15
# Optional comma-separated exact collection slugs. Blank means all.
LIVE_COLLECTIONS=
MAX_MODEL_RARITY_PCT=1.0
COLLECTIONS_PER_CYCLE=5
MAX_NEW_NFTS_PER_CYCLE=25
# Optional comma-separated real collection slugs, e.g. PlushPepe.
# Manual slugs are checked in addition to discovered catalog gifts.
GIFT_COLLECTIONS=
NOTIFY_PRICE_CHANGES=false
