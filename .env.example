# Telegram API credentials
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
BOT_TOKEN=
SESSION_STRING=

# Bothost keeps this folder between deployments
DATA_DIR=/app/data

# Telegram NFT scanner: target time for a full sweep (seconds)
CHECK_INTERVAL=60
NFT_SWEEP_SECONDS=60
NFT_REQUEST_SPACING_SECONDS=0.40
COLLECTIONS_PER_CYCLE=5
MAX_NEW_NFTS_PER_CYCLE=25
TRACK_RARE_NFTS=true

# Free see.tg WebSocket; no token is needed in guest mode
LIVE_ENABLED=true
SEE_TG_API_TOKEN=
LIVE_NOTIFY_NEW=true
LIVE_MAX_NEW_PER_MINUTE=15

# Optional collection filter, comma separated (leave blank for all)
GIFT_COLLECTIONS=
LIVE_COLLECTIONS=

# /pushall: maximum recent gift numbers per collection, total work, delay in seconds
RECOVERY_LOOKBACK=25
RECOVERY_MAX_TOTAL=1500
RECOVERY_ITEM_DELAY=2.0
